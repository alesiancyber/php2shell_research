// Evidence queries: the raw rows behind each case study, exported to evidence/<cve>/<name>.csv by
// scripts/export-evidence.py. Each block starts with "// out: <cve>/<name>". These are scoped by the
// lab's run id (_ResourceId), not a time window, so they reproduce against the saved WinLab database.

// --- out: cve-2026-109618/iis-requests
// The trigger request from every 109618 run: status, substatus, win32 status and time taken.
W3CIISLog
| where _ResourceId startswith "winlab/LAB-RUN-109618" and csUserAgent startswith "LAB-RUN-109618"
| project TimeGenerated, Run = tostring(split(_ResourceId, "/")[1]), Computer, cIP, sIP, csMethod, csUriStem,
          scStatus, scSubStatus, scWin32Status, TimeTaken, csBytes, csUserAgent
| order by TimeGenerated asc

// --- out: cve-2026-109618/php-error-log
// PHP's own error log (error_log = file). Note File/Line: the script OOM names oom-alloc.php line 10,
// the parse-path OOM has no script at all ("Unknown", 0).
PhpErrorLog_CL
| where _ResourceId startswith "winlab/LAB-RUN-109618"
| project TimeGenerated, Run = tostring(split(_ResourceId, "/")[1]), Computer, Level, Message, File, Line, SourceFile, RawData
| order by TimeGenerated asc

// --- out: cve-2026-109618/php-event-log
// The same fatals with error_log = syslog. PHP's event source is unregistered, so RenderedDescription is
// a placeholder and the real text is only in EventData.
Event
| where _ResourceId startswith "winlab/LAB-RUN-109618" and EventLog == "Application" and Source startswith "PHP"
| project TimeGenerated, Run = tostring(split(_ResourceId, "/")[1]), Computer, EventLog, Source, EventID,
          EventLevelName, RenderedDescription, EventData
| order by TimeGenerated asc

// --- out: cve-2026-109618/worker-lifecycle
// Every php-cgi.exe start and exit seen in the 109618 runs, from Security auditing (4688/4689) and Sysmon
// (1/5). Pids: Security writes hex, Sysmon decimal.
union
  (SecurityEvent
    | where _ResourceId startswith "winlab/LAB-RUN-109618" and EventID in (4688, 4689)
    | where NewProcessName has "php-cgi" or ProcessName has "php-cgi"
    | project TimeGenerated, Run = tostring(split(_ResourceId, "/")[1]), Computer, Source = "Security", EventID,
              Image = coalesce(NewProcessName, ProcessName),
              Pid = tostring(toint(coalesce(NewProcessId, ProcessId))), Parent = ParentProcessName, User = SubjectUserName),
  (Event
    | where _ResourceId startswith "winlab/LAB-RUN-109618" and Source has "Sysmon" and EventID in (1, 5)
    | extend d = parse_json(EventData)
    | where tostring(d[4]) has "php-cgi"
    | project TimeGenerated, Run = tostring(split(_ResourceId, "/")[1]), Computer, Source = "Sysmon", EventID,
              Image = tostring(d[4]), Pid = tostring(d[3]),
              Parent = iff(EventID == 1, tostring(d[20]), ""), User = iff(EventID == 1, tostring(d[12]), tostring(d[5])))
| order by TimeGenerated asc, Source asc

// --- out: cve-2026-109618/run-summary
// Detection query 0 (kql/detections-109618.kql): one row per run.
let scope = "winlab/LAB-RUN-109618";
union
  (W3CIISLog
    | where _ResourceId startswith scope and csUserAgent startswith "LAB-RUN-109618"
    | project Run=tostring(split(_ResourceId,"/")[1]),
              Request=strcat(csMethod," ",csUriStem," -> ",scStatus," (win32=",scWin32Status,")"),
              PhpError="", Worker=""),
  (PhpErrorLog_CL
    | where _ResourceId startswith scope
    | project Run=tostring(split(_ResourceId,"/")[1]), Request="",
              PhpError=strcat("file log: ...exhausted... in ",File," line ",tostring(Line)), Worker=""),
  (Event
    | where _ResourceId startswith scope and EventLog == "Application" and Source startswith "PHP"
    | project Run=tostring(split(_ResourceId,"/")[1]), Request="",
              PhpError=strcat("event log: ",substring(tostring(parse_json(EventData)[1]),0,80),"..."), Worker=""),
  (SecurityEvent
    | where _ResourceId startswith scope and EventID == 4689 and ProcessName has "php-cgi"
    | project Run=tostring(split(_ResourceId,"/")[1]), Request="", PhpError="", Worker="php-cgi EXITED (4689)")
| summarize Request=max(Request), PhpError=max(PhpError), Worker=max(Worker) by Run
| extend Case=extract(@"109618(B2|B1|A)",1,Run), Mode=case(Run has "SYSLOG","syslog", Run has "UNSET","unset","file")
| extend PhpError=iff(PhpError=="","(none logged - lost)",PhpError), Worker=iff(Worker=="","survived",Worker)
| project Case, Mode, Request, PhpError, Worker
| order by Case asc, Mode asc

// --- out: cve-2026-109619/iis-requests
// pid.php, timeout.php, pid.php. The timeout's TimeTaken matches the 2 s max_execution_time.
W3CIISLog
| where _ResourceId == "winlab/LAB-RUN-109619T-01" and csUserAgent startswith "LAB-RUN-109619"
| project TimeGenerated, Run = tostring(split(_ResourceId, "/")[1]), Computer, cIP, sIP, csMethod, csUriStem,
          scStatus, scSubStatus, scWin32Status, TimeTaken, csBytes, csUserAgent
| order by TimeGenerated asc, csUserAgent asc

// --- out: cve-2026-109619/php-error-log
// The timeout fatal.
PhpErrorLog_CL
| where _ResourceId == "winlab/LAB-RUN-109619T-01"
| project TimeGenerated, Run = tostring(split(_ResourceId, "/")[1]), Computer, Level, Message, File, Line, SourceFile, RawData

// --- out: cve-2026-109619/worker-lifecycle
// php-cgi.exe starts and exits during the 109619 run. Empty: the worker neither restarted nor exited.
union
  (SecurityEvent
    | where _ResourceId == "winlab/LAB-RUN-109619T-01" and EventID in (4688, 4689)
    | where NewProcessName has "php-cgi" or ProcessName has "php-cgi"
    | project TimeGenerated, Source = "Security", EventID, Image = coalesce(NewProcessName, ProcessName)),
  (Event
    | where _ResourceId == "winlab/LAB-RUN-109619T-01" and Source has "Sysmon" and EventID in (1, 5)
    | where tostring(parse_json(EventData)[4]) has "php-cgi"
    | project TimeGenerated, Source = "Sysmon", EventID, Image = tostring(parse_json(EventData)[4]))

// --- out: cve-2026-109619/reused-worker-fatals
// Detection B (kql/detections-109619.kql) over every run, without the time window: each PHP fatal and
// whether a php-cgi.exe exit followed within 5 s.
let fatals =
    PhpErrorLog_CL
    | where Level == "Fatal error"
    | project FatalTime = TimeGenerated, Computer, Fatal = Message, Run = tostring(split(_ResourceId, "/")[1]);
let exits =
    SecurityEvent
    | where EventID == 4689 and ProcessName has "php-cgi"
    | project ExitTime = TimeGenerated, Computer;
fatals
| join kind=leftouter exits on Computer
| summarize MinGap = min(abs(datetime_diff('second', FatalTime, ExitTime))) by FatalTime, Computer, Fatal, Run
| extend Worker = iff(isnull(MinGap) or MinGap > 5, "REUSED (no restart)", "restarted")
| project FatalTime, Run, Computer, Fatal, Worker
| order by FatalTime asc
